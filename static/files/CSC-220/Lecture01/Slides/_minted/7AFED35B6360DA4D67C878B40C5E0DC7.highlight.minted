\PYG{n}{batch} \PYG{o}{=} \PYG{n}{train\PYGZus{}images}\PYG{p}{[:}\PYG{l+m+mi}{128}\PYG{p}{]}

\PYG{c+c1}{\PYGZsh{} Next batch}
